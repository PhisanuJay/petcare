# คัดลอกไฟล์นี้เป็น .env แล้วเปลี่ยนค่ารหัสทุกตัวก่อนรัน
# สร้างคีย์กล้อง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SQLITE_PATH=D:\CCTV\data\cathotel.sqlite

JWT_SECRET=replace-with-a-long-random-string
CAMERA_SECRET=replace-with-64-hex-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=1234
HOTEL_NAME=Pet Hotel

# คั่นด้วยจุลภาค เป็น CIDR หรือชื่อโฮสต์ของกล้องเท่านั้น
CAMERA_RTSP_ALLOWLIST=192.168.0.0/16,10.0.0.0/8

# ที่อยู่เพิ่มของเครื่องนี้ ระบบใส่ 127.0.0.1 และ IP แลนที่พบเองอยู่แล้ว
WEBRTC_ADDITIONAL_HOST=127.0.0.1
WEBRTC_UDP_PORT=8189

MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
STREAM_SESSION_SECONDS=120
COOKIE_SECURE=false
NODE_ENV=development
